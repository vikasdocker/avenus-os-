schema_version=1
service_id=aether.ipc
name=Aether IPC
version=0.1.0
description=Internal IPC coordination capability for early Aether userspace services.
service_type=internal
dependencies=
startup_priority=10
restart_policy=never
restart_limit=0
restart_backoff_ms=100
health_check=none
security_identity=aether-system
requires_root=false
sandbox_profile=internal
permission_profile=system-internal
ipc_access=local-private
ipc_endpoints=unix:/run/aether/ipc/aether-system-core.sock
capabilities=request-response,service-discovery
resource_cpu_weight=100
resource_memory_max_kib=0
resource_process_limit=32
resource_io_weight=100
shutdown_timeout_ms=1000
