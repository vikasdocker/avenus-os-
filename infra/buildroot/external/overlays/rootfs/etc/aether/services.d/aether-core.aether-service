schema_version=1
service_id=aether.core
name=Aether Core
version=0.1.0
description=Phase 1.2 command, health, and shell coordination service supervised by Aether System Core.
service_type=process
command=/usr/sbin/aether-core
dependencies=aether.config
startup_priority=40
restart_policy=on-failure
restart_limit=3
restart_backoff_ms=500
health_check=file:/run/aether/health/aether-core.json
config_path=/etc/aether/aether-core.conf
security_identity=aether-core
requires_root=false
sandbox_profile=system-service
permission_profile=service-runtime
ipc_access=local-private
ipc_endpoints=fifo:/run/aether/ipc/aether-core.commands
capabilities=health,legacy-command-fifo
resource_cpu_weight=100
resource_memory_max_kib=0
resource_process_limit=32
resource_io_weight=100
shutdown_timeout_ms=5000
