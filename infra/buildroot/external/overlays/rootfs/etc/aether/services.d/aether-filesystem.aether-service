schema_version=1
service_id=aether.filesystem
name=Aether Filesystem Service
version=0.1.0
description=Managed filesystem and storage service enforcing scoped file operations through Aether IPC and capability policy.
service_type=process
command=/usr/sbin/aether-filesystemd --scope-root / --socket /run/aether/ipc/aether-filesystemd.sock --health /run/aether/health/aether-filesystemd.json
dependencies=aether.config
startup_priority=35
restart_policy=on-failure
restart_limit=3
restart_backoff_ms=500
health_check=file:/run/aether/health/aether-filesystemd.json
config_path=/etc/aether/aether-filesystem.conf
security_identity=aether-filesystem
requires_root=true
sandbox_profile=system-service
permission_profile=system-internal
ipc_access=local-private
ipc_endpoints=unix:/run/aether/ipc/aether-filesystemd.sock
capabilities=filesystem.read,filesystem.write,filesystem.create,filesystem.rename,filesystem.move,filesystem.copy,filesystem.delete,filesystem.list,filesystem.stat,filesystem.search,filesystem.watch,filesystem.mount.read,filesystem.storage.info
resource_cpu_weight=100
resource_memory_max_kib=0
resource_process_limit=32
resource_io_weight=100
shutdown_timeout_ms=5000
