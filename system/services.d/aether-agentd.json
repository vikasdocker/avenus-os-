{
  "schema_version": "1",
  "service_id": "aether-agentd",
  "name": "Aether Agent Daemon",
  "version": "0.1.0",
  "description": "AI control-plane agent with event ring and task state",
  "service_type": "Internal",
  "command": null,
  "dependencies": ["aether-system-core"],
  "startup_priority": 20,
  "restart_policy": "OnFailure",
  "restart_limit": 3,
  "restart_backoff_ms": 500,
  "health_check": null,
  "config_path": null,
  "security_identity": "agent.aether",
  "ipc_endpoints": [],
  "capabilities": ["audit.read"],
  "resource_cpu_weight": 1.0,
  "resource_memory_max_kib": 65536,
  "resource_process_limit": null,
  "resource_io_weight": 1.0,
  "requires_root": false,
  "sandbox_profile": "SystemService",
  "permission_profile": "ServiceRuntime",
  "ipc_access": "LocalPrivate",
  "shutdown_timeout_ms": 1000
}
