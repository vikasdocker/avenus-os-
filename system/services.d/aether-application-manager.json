{
  "schema_version": "1",
  "service_id": "aether-application-manager",
  "name": "Aether Application Manager",
  "version": "0.1.0",
  "description": "Application registry and launch lifecycle owner",
  "service_type": "Internal",
  "command": null,
  "dependencies": ["aether-agentd"],
  "startup_priority": 30,
  "restart_policy": "OnFailure",
  "restart_limit": 3,
  "restart_backoff_ms": 500,
  "health_check": null,
  "config_path": null,
  "security_identity": "apps.aether",
  "ipc_endpoints": ["applications"],
  "capabilities": ["application.launch"],
  "resource_cpu_weight": 1.0,
  "resource_memory_max_kib": 65536,
  "resource_process_limit": null,
  "resource_io_weight": 1.0,
  "requires_root": false,
  "sandbox_profile": "SystemService",
  "permission_profile": "ServiceRuntime",
  "ipc_access": "LocalPublic",
  "shutdown_timeout_ms": 1000
}
